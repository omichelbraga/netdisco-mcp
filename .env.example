NETDISCO_URL=https://netdisco.example.net
NETDISCO_API_TOKEN=replace-with-a-permanent-api-token
NETDISCO_AUTH_SCHEME=Bearer
NETDISCO_TLS_VERIFY=1
NETDISCO_READ_ONLY=0
NETDISCO_GUIDANCE_GATE=1
NETDISCO_GUIDANCE_TTL=1800
NETDISCO_MAX_RESPONSE_CHARS=50000
# stdio for local clients; streamable-http for remote clients
NETDISCO_MCP_TRANSPORT=stdio
NETDISCO_MCP_HTTP_HOST=127.0.0.1
NETDISCO_MCP_HTTP_PORT=8000
NETDISCO_MCP_BEARER_TOKEN=replace-with-a-separate-random-token
